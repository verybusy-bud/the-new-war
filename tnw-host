#!/bin/bash
# tnw-host - Start The New War server and connect as first player
#
# Usage: tnw-host [-p players] [--port PORT]
# Example: tnw-host -p 2 --port 7777
#
# If launched from BBS without -p, will prompt for number of players

PLAYERS=""
PORT=7777

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -p*)
            # Handle -p2 or -p 2
            if [[ "$1" == "-p" ]]; then
                PLAYERS="$2"
                shift 2
            else
                PLAYERS="${1#-p}"
                shift
            fi
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# If players not specified, ask (for BBS door launches)
if [[ -z "$PLAYERS" ]]; then
    echo ""
    echo "========================================"
    echo "THE NEW WAR - Multiplayer Empire"
    echo "========================================"
    echo ""
    echo -n "How many players? (2-4) [2]: "
    
    # Read from stdin (user's terminal via BBS)
    read -r player_input
    
    # Validate input
    if [[ "$player_input" =~ ^[2-4]$ ]]; then
        PLAYERS="$player_input"
    else
        PLAYERS=2
    fi
    
    echo "Starting game for $PLAYERS players..."
    echo ""
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Kill any existing server on this port
pkill -f "tnw.*--port $PORT" 2>/dev/null
pkill -f "tnw.*--port.*$PORT" 2>/dev/null
sleep 1

# Check if server is already running
if nc -z localhost "$PORT" 2>/dev/null; then
    echo "Server already running on port $PORT"
    echo "Connecting as player..."
    exec "$SCRIPT_DIR/door" localhost "$PORT"
fi

# Start server in background
echo "Starting The New War server on port $PORT for $PLAYERS players..."
"$SCRIPT_DIR/tnw" -p "$PLAYERS" --server --port "$PORT" &
SERVER_PID=$!

# Wait for server to start
for i in {1..20}; do
    if nc -z localhost "$PORT" 2>/dev/null; then
        # Server port is open, but need time to initialize
        echo "Server ready!"
        sleep 2
        break
    fi
    sleep 0.5
done

# Check if server started
if ! nc -z localhost "$PORT" 2>/dev/null; then
    echo "Failed to start server"
    kill $SERVER_PID 2>/dev/null
    exit 1
fi

# Connect as first player
echo "Connecting as Player 1..."
exec "$SCRIPT_DIR/door" localhost "$PORT"
